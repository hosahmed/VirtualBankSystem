{
    "openapi": "3.1.0",
    "info": {
        "title": "Transaction Service API",
        "description": "API documentation for the Virtual Bank Transaction Service",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8083",
            "description": "Generated server url"
        }
    ],
    "tags": [
        {
            "name": "Transaction Service",
            "description": "Financial transfers and transaction history"
        }
    ],
    "paths": {
        "/transactions/transfer/initiation": {
            "post": {
                "tags": [
                    "Transaction Service"
                ],
                "summary": "Initiate a fund transfer",
                "operationId": "initiateTransfer",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/TransferInitiationRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Transfer initiated",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/TransferInitiationResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid accounts or insufficient funds",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/transactions/transfer/execution": {
            "post": {
                "tags": [
                    "Transaction Service"
                ],
                "summary": "Execute an initiated transfer",
                "operationId": "executeTransfer",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/TransferExecutionRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Transfer executed",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/TransferExecutionResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid transaction ID or insufficient funds",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/accounts/{accountId}/transactions": {
            "get": {
                "tags": [
                    "Transaction Service"
                ],
                "summary": "Get transaction history for an account",
                "operationId": "getTransactionHistory",
                "parameters": [
                    {
                        "name": "accountId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Transaction history",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/TransactionHistoryResponse"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No transactions found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "TransferInitiationRequest": {
                "type": "object",
                "properties": {
                    "fromAccountId": {
                        "type": "string",
                        "format": "uuid",
                        "example": "f1e2d3c4-b5a6-9876-5432-10fedcba9876"
                    },
                    "toAccountId": {
                        "type": "string",
                        "format": "uuid",
                        "example": "g7h8i9j0-k1l2-3456-7890-abcdef123456"
                    },
                    "amount": {
                        "type": "number",
                        "example": 30.0,
                        "minimum": 0.01
                    },
                    "description": {
                        "type": "string",
                        "example": "Transfer to checking account"
                    }
                },
                "required": [
                    "amount",
                    "fromAccountId",
                    "toAccountId"
                ]
            },
            "TransferInitiationResponse": {
                "type": "object",
                "properties": {
                    "transactionId": {
                        "type": "string",
                        "format": "uuid",
                        "example": "t1r2a3n4-s5a6-7890-1234-567890abcdef"
                    },
                    "status": {
                        "type": "string",
                        "example": "Initiated"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-07-15T07:16:49.822Z"
                    }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "integer",
                        "format": "int32",
                        "example": 404
                    },
                    "error": {
                        "type": "string",
                        "example": "Not Found"
                    },
                    "message": {
                        "type": "string",
                        "example": "Transaction not found."
                    }
                }
            },
            "TransferExecutionRequest": {
                "type": "object",
                "properties": {
                    "transactionId": {
                        "type": "string",
                        "format": "uuid",
                        "example": "t1r2a3n4-s5a6-7890-1234-567890abcdef"
                    }
                },
                "required": [
                    "transactionId"
                ]
            },
            "TransferExecutionResponse": {
                "type": "object",
                "properties": {
                    "transactionId": {
                        "type": "string",
                        "format": "uuid",
                        "example": "t1r2a3n4-s5a6-7890-1234-567890abcdef"
                    },
                    "status": {
                        "type": "string",
                        "example": "Success"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-07-15T07:16:49.822Z"
                    }
                }
            },
            "TransactionHistoryResponse": {
                "type": "object",
                "properties": {
                    "transactionId": {
                        "type": "string",
                        "format": "uuid",
                        "example": "t1r2a3n4-s5a6-7890-1234-567890abcdef"
                    },
                    "fromAccountId": {
                        "type": "string",
                        "format": "uuid",
                        "example": "f1e2d3c4-b5a6-9876-5432-10fedcba9876"
                    },
                    "toAccountId": {
                        "type": "string",
                        "format": "uuid",
                        "example": "f2e3d3c4-b5a6-9876-5432-10fedbba9876"
                    },
                    "amount": {
                        "type": "number",
                        "example": 50.0
                    },
                    "description": {
                        "type": "string",
                        "example": "Cash deposit"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-06-30T10:05:00Z"
                    },
                    "deliveryStatus": {
                        "type": "string",
                        "example": "SENT"
                    }
                }
            }
        }
    }
}
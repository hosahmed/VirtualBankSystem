<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>VirtualBankSystem</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>bff-service</artifactId>
    <packaging>jar</packaging>
    <name>bff-service</name>
    <description>Backend for Frontend - aggregates User, Account, and
        Transaction services for the frontend/gateway consumer.</description>

    <dependencies>
        <!-- Exposes the BFF's own REST endpoints (e.g. /bff/dashboard/{userId})
             to the gateway/frontend. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- WebClient lives here. We use it for OUTBOUND calls to
             User/Account/Transaction Service even though this service's
             own inbound API is synchronous MVC (webmvc above) - that
             combination (blocking MVC controller, reactive WebClient
             calls collected with .block() at the boundary) is a common
             and supported pattern, and simpler for a small team than
             going fully reactive (WebFlux end-to-end) for one endpoint
             that needs parallel fan-out. If this service grows more
             high-concurrency aggregation endpoints, revisit full WebFlux. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Producer side of the project's Kafka logging requirement
             (spec section 5) - every microservice must publish a
             {message, messageType, dateTime} envelope for each
             request/response to a shared topic, consumed by
             logging-service. This was the gap flagged when
             logging-service was scaffolded - see
             logging/RequestResponseLoggingFilter.java. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>bff-service</finalName>
    </build>
</project>
